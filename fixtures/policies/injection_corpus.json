{
  "rules": [
    { "label": "ignore-instructions", "pattern": ["ignore", "?all", "previous|prior|above|earlier", "instructions|directives|instruction|directive|prompt|prompts"] },
    { "label": "disregard-instructions", "pattern": ["disregard", "?all", "previous|prior|above", "instructions|directives|instruction|directive|prompt|prompts"] },
    { "label": "override-rules", "pattern": ["forget|override", "your|all|the", "previous|prior|system", "instructions|rules|rule|instruction"] },
    { "label": "role-redefinition", "pattern": ["you", "are", "now|no", "?longer", "a|an|the"] },
    { "label": "system-prompt", "pattern": ["system", "prompt"] },
    { "label": "developer-message", "pattern": ["developer", "message"] },
    { "label": "disobedience", "pattern": ["do", "not", "follow|obey|listen"] },
    { "label": "jailbreak", "pattern": ["jailbreak"] },
    { "label": "role-claim", "pattern": ["as", "an", "ai", "language", "model"] }
  ]
}
